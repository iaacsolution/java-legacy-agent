# Copier en .env (jamais commité, voir .gitignore) et remplir les valeurs réelles.
# Générer des valeurs aléatoires, par ex. : openssl rand -base64 24 | tr -d '=+/' | cut -c1-24

# Clé API Anthropic (priorité 2 dans LlmModelFactory si pas de GPU)
ANTHROPIC_API_KEY=

# Doit être explicitement "true" pour que la clé ci-dessus soit utilisée.
# Sans ce flag, le code source analysé ne sort JAMAIS du périmètre (bascule
# automatique sur Ollama CPU) même si ANTHROPIC_API_KEY est renseignée.
# Ne l'activer que pour la démo HF Space (code non sensible), jamais sur un
# vrai code client.
ALLOW_CLOUD_CODE_ANALYSIS=false

# Token Hugging Face (pull de modèle vLLM)
HF_TOKEN=

# Admin Grafana (dashboards agent, port 3003)
GF_ADMIN_PASSWORD=

# Admin Airflow (orchestration, port 8083) — mot de passe distinct de Grafana
AIRFLOW_ADMIN_PASSWORD=
# Clé de signature de session Airflow (Flask secret_key) — 32+ octets aléatoires
AIRFLOW_SECRET_KEY=

# ── Flight recorder (spans du pipeline vers TimescaleDB) ────────────────────
# Désactivé par défaut : sans ce flag à "true", aucun thread, aucune connexion,
# aucun effet sur le pipeline.
FLIGHTREC_ENABLED=false

# Base CIBLE : legacyrec. Ne JAMAIS pointer sur flightrec, qui contient les
# données du cours TimescaleDB — les deux bases cohabitent dans le même
# conteneur (timescale-course), seul le nom de base les sépare.
#   base locale existante  : jdbc:postgresql://localhost:5432/legacyrec
#   profil docker compose  : jdbc:postgresql://localhost:5433/legacyrec
FLIGHTREC_URL=jdbc:postgresql://localhost:5432/legacyrec
FLIGHTREC_USER=postgres

# Aucune valeur par défaut en dur côté Java : à renseigner ici. À défaut, la
# variable standard PGPASSWORD est lue en second recours.
FLIGHTREC_PASSWORD=

# Partager un même run_id entre les phases analyze et report (deux process JVM
# distincts). Laisser vide pour qu'un identifiant soit généré à chaque process.
FLIGHTREC_RUN_ID=
