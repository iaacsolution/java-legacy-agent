#!/bin/sh
# Hook Git pre-commit — détection des changements cassants sur les signatures Java
# Installation : cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Filtre de detection de secrets, isole dans une fonction pour que le self-test
# (--self-test) exerce exactement le meme code que le hook reel : un test qui
# reimplementerait le filtre ne prouverait rien sur le filtre reellement utilise.
# Lit des lignes de diff sur stdin, ecrit les lignes suspectes sur stdout.
scan_secrets() {
    grep -E '^\+' | grep -viE '^\+\+\+' \
    | grep -iE '(password|passwd|secret|api[_-]?key|token)[A-Za-z_]*[[:space:]]*[:=][[:space:]]*[^[:space:]]+' \
    | grep -viE '\$\{|\$\(|System\.getenv|process\.env|getenv\(' \
    | grep -viE '[:=][[:space:]]*(EMPTY|true|false|changeme|placeholder|xxx+|TODO)[[:space:]"'"'"']*$' \
    | awk -v q="'" '
        # PowerShell : $env:VAR est la lecture d environnement equivalente a
        # System.getenv, deja en liste blanche ci-dessus (le shell principal de
        # ce poste est PowerShell). MAIS $env: permet AUSSI d ecrire, ce que
        # System.getenv ne permet pas : une affectation vers une chaine
        # litterale ($env:CLE = "sk-ant-...") reste un secret en dur et doit
        # rester bloquee. Seules les LECTURES sont donc blanchies ici.
        {
            ecrit_litteral = ($0 ~ ("\\$env:[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*[\"" q "]"))
            mentionne_env  = ($0 ~ /\$env:/)
            if (mentionne_env && !ecrit_litteral) next
            print
        }'
}

# --self-test : verifie les deux cas limites PowerShell sans toucher a git.
#   sh hooks/pre-commit --self-test
if [ "$1" = "--self-test" ]; then
    echo "=== Self-test du Secret Scan ==="
    echec=0

    cas_lecture='+$key = $env:ANTHROPIC_API_KEY'
    if [ -z "$(printf '%s\n' "$cas_lecture" | scan_secrets)" ]; then
        echo "  OK     lecture acceptee  : $cas_lecture"
    else
        echo "  ECHEC  lecture bloquee   : $cas_lecture"
        echec=1
    fi

    # Assemble a l execution : ecrit en toutes lettres, cette ligne serait
    # elle-meme detectee comme un secret en dur par le filtre qu elle teste.
    faux_jeton='sk-ant-TEST'
    cas_ecriture="+\$env:ANTHROPIC_API_KEY = \"$faux_jeton\""
    if [ -n "$(printf '%s\n' "$cas_ecriture" | scan_secrets)" ]; then
        echo "  OK     ecriture bloquee  : $cas_ecriture"
    else
        echo "  ECHEC  ecriture acceptee : $cas_ecriture"
        echec=1
    fi

    if [ "$echec" -eq 0 ]; then echo "Self-test : OK"; else echo "Self-test : ECHEC"; fi
    exit "$echec"
fi

echo "=== Secret Scan ==="
SECRET_HITS=$(git diff --cached -U0 -- . ':!*.md' | scan_secrets)

if [ -n "$SECRET_HITS" ]; then
    echo "BLOQUÉ : secret potentiel en dur détecté dans le diff :"
    echo "$SECRET_HITS"
    echo "Utilisez une variable d'environnement (voir .env.example) au lieu d'une valeur en dur."
    exit 1
fi

echo "=== Anti-logRequests Guard ==="
# .logRequests(true)/.logResponses(true) (LangChain4j) loguent aussi les headers HTTP,
# donc le header x-api-key en clair -- deja tente et rejete une fois cette session
# (voir historique), jamais laisse entrer dans le code. Empeche toute reintroduction.
LOGREQ_HITS=$(git diff --cached -U0 -- '*.java' \
    | grep -E '^\+' | grep -viE '^\+\+\+' \
    | grep -iE '\.log(Requests|Responses)\([[:space:]]*true[[:space:]]*\)')

if [ -n "$LOGREQ_HITS" ]; then
    echo "BLOQUÉ : logRequests(true)/logResponses(true) détecté dans le diff :"
    echo "$LOGREQ_HITS"
    echo "Ce flag logue aussi les headers HTTP (donc x-api-key en clair). Ne jamais l'activer"
    echo "sur un builder Anthropic/vLLM. Voir LlmModelFactory.java."
    exit 1
fi

AGENT_IMAGE="java-legacy-agent-java-agent"
PROJECT_PATH="/app/src"

echo "=== Breaking Change Detector ==="

# Récupère les fichiers Java modifiés dans le commit en cours
CHANGED_JAVA=$(git diff --cached --name-only --diff-filter=M | grep "\.java$")

if [ -z "$CHANGED_JAVA" ]; then
    echo "Aucun fichier Java modifié — pas d'analyse d'impact."
    exit 0
fi

BREAKING=0

for FILE in $CHANGED_JAVA; do
    # Extrait le nom de classe depuis le chemin (ex: src/.../ClientServiceBean.java)
    CLASS=$(basename "$FILE" .java)

    # Récupère les signatures de méthodes modifiées via git diff
    METHODS=$(git diff --cached "$FILE" | grep "^-.*public\|^-.*protected" \
        | grep -oP '(?<=\s)\w+(?=\()' | sort -u)

    for METHOD in $METHODS; do
        echo "Analyse impact : $CLASS.$METHOD()"

        # Chemin Windows pour Docker (via PowerShell pour éviter la conversion Git Bash)
        WIN_PATH=$(powershell.exe -Command "(Get-Location).Path" 2>/dev/null | tr -d '\r\n')
        RESULT=$(MSYS_NO_PATHCONV=1 docker run --rm \
            -v "${WIN_PATH}:/project" \
            "$AGENT_IMAGE" \
            impact /project/agent/src "$CLASS" "$METHOD" --json 2>&1)
        echo "DEBUG severity=$SEVERITY callers=$CALLERS"

        SEVERITY=$(echo "$RESULT" | grep -oP '(?<="severity": ")[^"]+')
        CALLERS=$(echo "$RESULT" | grep -oP '(?<="callers_count": )\d+')

        if [ "$SEVERITY" = "MEDIUM" ] || [ "$SEVERITY" = "HIGH" ] || [ "$SEVERITY" = "CRITICAL" ]; then
            echo "BLOQUÉ : $CLASS.$METHOD() — $CALLERS appelant(s) — sévérité $SEVERITY"
            echo "$RESULT"
            BREAKING=1
        elif [ -n "$CALLERS" ] && [ "$CALLERS" -gt 0 ]; then
            echo "AVERTISSEMENT : $CLASS.$METHOD() — $CALLERS appelant(s) — sévérité $SEVERITY"
        fi
    done
done

if [ "$BREAKING" -eq 1 ]; then
    echo ""
    echo "Commit bloqué — changements cassants détectés."
    echo "Corrigez les appelants ou utilisez @Deprecated en transition."
    exit 1
fi

echo "Analyse terminée — aucun changement cassant bloquant."
exit 0
